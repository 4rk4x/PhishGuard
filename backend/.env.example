PROJECT_NAME="PhishGuard Phishing URL Detection System"
ENVIRONMENT="development"

# Generate a private secret of at least 32 characters.
SECRET_KEY="replace-with-your-own-random-secret-of-at-least-32-characters"

ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL="sqlite:///./phishguard.db"

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

MODEL_DIR="app/ml/model_storage"

DEFAULT_ADMIN_EMAIL="admin@phishguard.ac.in"
DEFAULT_ADMIN_PASSWORD=""

DEFAULT_USER_EMAIL="student@phishguard.ac.in"
DEFAULT_USER_PASSWORD=""

ENABLE_DEMO_LOGIN=false